# ==============================================================================
# STREAMVAULT / NETFLIX CLONE - ENVIRONMENT CONFIGURATION TEMPLATE
# Production-ready, 100% Free-Tier & Self-Hostable Media Streaming Architecture
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND (Vite + React 19 + TypeScript + Capacitor Ready)
# ------------------------------------------------------------------------------
# Public Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon (Publishable) Key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Media Server public API endpoint (or Cloudflare Tunnel URL in production)
VITE_MEDIA_SERVER_URL=http://localhost:8000

# Application Branding and Base Settings
VITE_APP_NAME="StreamVault"
VITE_APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL + Supabase Auth + Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (Keep strictly confidential! Used only by Backend & Local Admin)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct PostgreSQL Connection URI (for migrations or direct backend pooling)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# JWT Secret used by Supabase Auth (Found in Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: Supabase Personal Access Token for automated CLI syncing
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=your-project-id

# ------------------------------------------------------------------------------
# 3. MEDIA_SERVER (Python 3.12+ FastAPI + FFmpeg Transcode/Remux Worker)
# ------------------------------------------------------------------------------
MEDIA_SERVER_HOST=0.0.0.0
MEDIA_SERVER_PORT=8000

# Storage Directories (Absolute paths recommended)
MEDIA_INCOMING_DIR=/absolute/path/to/media/incoming
MEDIA_LIBRARY_DIR=/absolute/path/to/media/library
MEDIA_TEMP_DIR=/absolute/path/to/media/temp

# HMAC-SHA256 Secret for generating and validating time-limited .m3u8 stream playback tokens
# Generate with: openssl rand -hex 32
HMAC_STREAM_SECRET=generate_with_openssl_rand_hex_32

# Token lifetime in seconds (default: 14400 = 4 hours)
STREAM_TOKEN_TTL_SECONDS=14400

# Mutually authenticated Admin API Key shared between Local Admin Panel & Media Server
# Generate with: openssl rand -hex 32
ADMIN_API_SECRET=generate_with_openssl_rand_hex_32

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4000,http://127.0.0.1:5173,http://127.0.0.1:4000

# Public or Cloudflare Edge Base URL for HLS streaming chunks (if using Cloudflare Tunnel)
# Leave empty to default to MEDIA_SERVER_URL
STREAM_PUBLIC_BASE_URL=

# Transcoding safety configuration
DEFAULT_TRANSCODING_ENABLED=false
MAX_TRANSCODE_THREADS=4
HW_ACCEL_PREFERENCE=auto

# ------------------------------------------------------------------------------
# 4. ADMIN_LOCAL (Decoupled Local Admin Dashboard on 127.0.0.1:4000)
# ------------------------------------------------------------------------------
ADMIN_PORT=4000
ADMIN_HOST=127.0.0.1

# Admin panel's internal connection to the Media Server API
MEDIA_SERVER_INTERNAL_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 5. METADATA_APIS (Permanent Ingestion Cache in PostgreSQL)
# ------------------------------------------------------------------------------
# The Movie Database (TMDB) API v3 Read Access Token (Bearer token, Recommended)
# Register at: https://www.themoviedb.org/settings/api
TMDB_API_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# TMDB API v3 Key (32-character hex key fallback)
TMDB_API_KEY=your_tmdb_api_key_here

# Open Movie Database (OMDb) API Key (for IMDb and Rotten Tomatoes ratings)
# Register free (1,000 req/day) at: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# ------------------------------------------------------------------------------
# 6. ARIA2_RPC (Local High-Performance Download Daemon)
# ------------------------------------------------------------------------------
ARIA2_RPC_HOST=127.0.0.1
ARIA2_RPC_PORT=6800
# Generate with: openssl rand -hex 16
ARIA2_RPC_SECRET=generate_with_openssl_rand_hex_16
ARIA2_RPC_SSL=false
ARIA2_DOWNLOAD_DIR=/absolute/path/to/media/incoming

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL (Resend Custom SMTP in Supabase Auth)
# ------------------------------------------------------------------------------
# Configured directly in Supabase Dashboard -> Authentication -> SMTP Settings:
# Host: smtp.resend.com
# Port: 465 (SSL) or 587 (TLS)
# User: resend
# Pass: re_your_resend_api_key (Your Resend API Key from https://resend.com)
# Sender Email: noreply@yourdomain.com (or verified domain email)
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_SENDER_EMAIL=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE PUBLIC TUNNEL & FREE DOMAIN (No custom domain required)
# ------------------------------------------------------------------------------
# Automatically managed by install.sh / start.sh
# Enable background tunnel: true | false
ENABLE_TUNNEL=false
# Tunnel Type: 'quick' (*.trycloudflare.com) | 'pages' (*.pages.dev) | 'none'
TUNNEL_TYPE=none
# Public domain or Pages subdomain (e.g. streamvault.pages.dev)
PUBLIC_DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:8080
# Optional: Cloudflare Pages automated sync credentials
CF_PAGES_PROJECT=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
